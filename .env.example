# Copy to .env.local; never commit real values. For local keys: supabase status -o env.
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_ANON_KEY=replace-with-local-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-or-server-secret-key
DEMO_EMAIL=demo@example.test
DEMO_PASSWORD=replace-with-a-long-demo-password
# Seed prints the account ID; copy it here before serving functions.
DEMO_USER_ID=
CLEANUP_SECRET=replace-with-a-random-secret-at-least-32-characters
# Needed locally: Edge Functions see an internal origin, clients need the public origin.
PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
# Optional local runner fallback; omit when using Supabase Edge Runtime.
# FUNCTIONS_ORIGIN=http://127.0.0.1:56325
